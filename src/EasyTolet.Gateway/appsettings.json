    },
    "search": {
      "Address": "http://easytolet.searchservice:80/"
    },
    "booking": {
      "Address": "http://easytolet.bookingservice:80/"
    },
    "payment": {
      "Address": "http://easytolet.paymentservice:80/"
    },
    "agreement": {
      "Address": "http://easytolet.agreementservice:80/"
    },
    "notification": {
      "Address": "http://easytolet.notificationservice:80/"
    },
    "chat": {
      "Address": "http://easytolet.chatservice:80/"
    },
    "review": {
      "Address": "http://easytolet.reviewservice:80/"
    },
    "wishlist": {
