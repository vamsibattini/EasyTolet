{
  "RabbitMq": {
    "Host": "rabbitmq",
    "Username": "guest",
    "Password": "guest"
  },
  "Jwt": {
    "Authority": "https://identity.local",
    "Audience": "EasyTolet.Api"
  },
  "ExceptionLogging": {
    "Directory": "logs/exceptions",
    "DatabaseEnabled": true,
    "SinkTimeoutSeconds": 5,
    "Database": {
      "Server": "localhost",
      "Port": 3306,
      "Database": "EasyTolet.GatewayLogsDb",
      "User": "easytolet_gateway_logs",
      "SslMode": "VerifyFull"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "DownstreamServices": {
    "identity": {
      "Address": "http://easytolet.identityservice:80/"
    },
    "user": {
      "Address": "http://easytolet.userservice:80/"
    },
    "property": {
